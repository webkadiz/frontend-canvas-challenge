{
  "name": "@canvas/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint . --max-warnings 0",
    "lint:styles": "stylelint 'src/**/*.scss' --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort"
  },
  "dependencies": {
    "@canvas/contracts": "1.0.0",
    "@xyflow/react": "12.11.6",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "^29.1.1",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
